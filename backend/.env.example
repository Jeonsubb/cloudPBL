# PortPulse 환경변수 예시

# AWS 리전
AWS_REGION=ap-northeast-2

# Aurora PostgreSQL (Data API)
DB_CLUSTER_ARN=arn:aws:rds:ap-northeast-2:ACCOUNT_ID:cluster:portpulse-db
DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:portpulse-db-creds
DB_NAME=portpulse
USE_DATA_API=true

# 공공데이터포털 API 키 (KCCI, 관세청)
PUBLIC_DATA_API_KEY=YOUR_PUBLIC_DATA_PORTAL_KEY

# 한국은행 ECOS Open API
ECOS_API_KEY=YOUR_ECOS_API_KEY

# Amazon Bedrock (서울 리전 사용 가능)
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
BEDROCK_AGENT_ID=YOUR_BEDROCK_AGENT_ID
BEDROCK_AGENT_ALIAS_ID=YOUR_BEDROCK_AGENT_ALIAS_ID

# 텔레그램 봇
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# 카카오 알림톡 (선택)
KAKAO_REST_API_KEY=YOUR_KAKAO_KEY
